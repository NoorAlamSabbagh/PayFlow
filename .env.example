# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payflow_db
DB_USER=payflow_user
DB_PASSWORD=payflow_secure_password
DB_SSL=false
DATABASE_URL=postgresql://payflow_user:payflow_secure_password@localhost:5432/payflow_db

# Redis Cache & Locking
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_ACCESS_SECRET=super_secret_access_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# AWS & SQS Configuration (Uses LocalStack in development)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
AWS_SQS_ENDPOINT=http://localhost:4566
SQS_TRANSACTION_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/payflow-transaction-events.fifo
SQS_NOTIFICATIONS_QUEUE_URL=http://localhost:4566/000000000000/payflow-notifications

# Mock Payment Gateway Webhook Secret
MOCK_GATEWAY_WEBHOOK_SECRET=whsec_mock_super_secret_hmac_key_2026

# Financial & Risk Engine Constraints (amounts in integer paise/cents)
MAX_SINGLE_TRANSFER_AMOUNT=5000000       # ₹50,000.00
MAX_DAILY_TRANSFER_AMOUNT=20000000       # ₹2,00,000.00
MAX_TRANSFERS_PER_MINUTE=5
